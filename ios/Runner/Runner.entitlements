<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. "production" is required for TestFlight / App Store.
	     (Firebase's APNs .p8 key works for both sandbox and production.) -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links for the password-reset email link. Host must match
	     RESET_LINK_BASE_URL on the server. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hris-api.ardentnetworks.com.ph</string>
	</array>
</dict>
</plist>
